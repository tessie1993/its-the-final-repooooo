<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/geode_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/geode_widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="10dp">
    <ImageView
        android:id="@+id/geode_widget_art"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/geode_nature_leaf" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:paddingStart="10dp"
        android:paddingEnd="6dp"
        android:orientation="vertical">
        <TextView
            android:id="@+id/geode_widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/geode_widget_title"
            android:textColor="#F1F3DE"
            android:textSize="14sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/geode_widget_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/geode_widget_open"
            android:textColor="#B6C7A8"
            android:textSize="11sp" />
    </LinearLayout>
    <ImageButton
        android:id="@+id/geode_widget_previous"
        android:layout_width="40dp"
        android:layout_height="48dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/geode_widget_previous"
        android:padding="9dp"
        android:src="@drawable/geode_widget_previous" />
    <ImageButton
        android:id="@+id/geode_widget_play"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/geode_widget_control"
        android:contentDescription="@string/geode_widget_play"
        android:padding="11dp"
        android:src="@drawable/geode_widget_play" />
    <ImageButton
        android:id="@+id/geode_widget_next"
        android:layout_width="40dp"
        android:layout_height="48dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/geode_widget_next"
        android:padding="9dp"
        android:src="@drawable/geode_widget_next" />
</LinearLayout>
