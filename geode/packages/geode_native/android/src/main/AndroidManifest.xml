<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  package="dev.geode.geode_native">
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
  <uses-permission android:name="android.permission.WAKE_LOCK" />
  <uses-permission android:name="android.permission.RECORD_AUDIO" />
  <!-- Android 13+: the media playback notification is hidden without it. -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <uses-feature android:name="android.software.live_wallpaper" android:required="false" />
  <application>
    <service
      android:name="dev.geode.geode_native.GeodePlaybackService"
      android:exported="false"
      android:foregroundServiceType="mediaPlayback"
      android:stopWithTask="false" />
    <service
      android:name="dev.geode.geode_native.GeodeWallpaperService"
      android:label="@string/geode_wallpaper_name"
      android:permission="android.permission.BIND_WALLPAPER"
      android:exported="true">
      <intent-filter><action android:name="android.service.wallpaper.WallpaperService" /></intent-filter>
      <meta-data android:name="android.service.wallpaper" android:resource="@xml/geode_wallpaper" />
    </service>
    <service
      android:name="dev.geode.geode_native.GeodeDreamService"
      android:label="@string/geode_dream_name"
      android:permission="android.permission.BIND_DREAM_SERVICE"
      android:exported="true">
      <intent-filter><action android:name="android.service.dreams.DreamService" /></intent-filter>
      <meta-data android:name="android.service.dream" android:resource="@xml/geode_dream" />
    </service>
    <receiver
      android:name="dev.geode.geode_native.GeodeNowPlayingWidget"
      android:label="@string/geode_widget_name"
      android:exported="false">
      <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
      <meta-data android:name="android.appwidget.provider" android:resource="@xml/geode_now_playing_widget" />
    </receiver>
  </application>
</manifest>
